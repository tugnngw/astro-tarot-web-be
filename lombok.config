# Danh dau moi thu Lombok sinh ra bang @lombok.Generated.
#
# JaCoCo tu bo qua nhung phuong thuc mang annotation ten "Generated". Khong co
# dong nay thi hang nghin getter/setter/equals/hashCode do Lombok sinh ra bi
# tinh la ma chua phu — mau so phinh len, con so tut xuong, va khong ai viet
# test cho getter ca.
#
# Day khong phai meo lam dep so: no loai ra dung nhung dong khong ai viet va
# khong ai can kiem.
lombok.addLombokGeneratedAnnotation = true

# Dung tim len thu muc cha nua.
config.stopBubbling = true
