# ============================================================
# astra-tarot-web-be — mẫu biến môi trường
# Copy sang .env rồi điền giá trị thật. KHÔNG commit .env.
#   cp .env.example .env
# File .env được nạp bởi spring-dotenv (me.paulschwarz:spring-dotenv).
# ============================================================

# ---------- Database ----------
# docker-compose map postgres ra cổng 5433 của host (5433:5432).
# Chạy BE ngoài Docker  -> dùng 5433.
# Chạy BE trong Docker  -> profile "docker" tự trỏ vào host "postgres:5432".
DB_PASSWORD=

# ---------- JWT ----------
# Bắt buộc >= 32 ký tự (JwtSecretValidationConfig kiểm tra lúc khởi động).
# Dùng làm khoá HMAC-SHA256 dạng raw UTF-8, không phải base64.
# Sinh mới: openssl rand -base64 48
JWT_SECRET=
# Thời hạn access token, tính bằng ms. Mặc định 900000 (15 phút).
JWT_EXPIRATION=900000

# ---------- Mã hoá dữ liệu nhạy cảm (AES-256-GCM) ----------
# PHẢI là base64 của đúng 32 byte, nếu sai độ dài app sẽ crash lúc start.
# Sinh mới: openssl rand -base64 32
ASTRO_ENCRYPTION_KEY=

# ---------- Google OAuth2 ----------
# Lấy ở Google Cloud Console > APIs & Services > Credentials.
# Redirect URI cần khai báo: http://localhost:8080/login/oauth2/code/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------- Gemini AI ----------
# Thiếu 2 biến này app vẫn start, nhưng mọi chức năng AI chat / AI reading sẽ lỗi.
GEMINI_API_KEY=
GEMINI_API_ENDPOINT=

# ---------- SMTP (gửi mail xác thực) ----------
# Gmail thì MAIL_PASSWORD là App Password 16 ký tự, không phải mật khẩu tài khoản.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
MAIL_FROM_EMAIL=astratarot.noreply@gmail.com
MAIL_FROM_NAME=Astra Tarot

# ---------- Redis ----------
REDIS_HOST=localhost
REDIS_PORT=6379

# ---------- Tuỳ chọn: log ----------
JDBC_LOG_LEVEL=WARN
JPA_SHOW_SQL=false

# ---------- Host/port DB cho dev ngoài Docker ----------
DB_HOST=localhost
DB_PORT=5433

# ---------- Upload ----------
# Thư mục lưu file người dùng tải lên (avatar).
UPLOAD_DIR=uploads

# ---------- PayOS (https://my.payos.vn → Thông tin kết nối) ----------
# Đủ 3 key thì checkout tự động; thiếu thì vẫn dùng chuyển khoản tay.
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
# Local: để trống return/cancel (dùng FRONTEND_URL). Webhook cần URL public (ngrok).
PAYOS_RETURN_URL=
PAYOS_CANCEL_URL=
PAYOS_WEBHOOK_URL=

# ---------- Bank (dự phòng khi chưa bật PayOS) ----------
BANK_NAME=
BANK_ACCOUNT_NUMBER=
BANK_ACCOUNT_HOLDER=

FRONTEND_URL=http://localhost:8081
