# ============================================================
# Mẫu biến môi trường cho VPS. Chép thành .env NGAY CẠNH
# docker-compose.prod.yml rồi điền giá trị thật:
#
#   cp .env.prod.example .env && nano .env
#   chmod 600 .env
#
# File .env KHÔNG được commit (đã nằm trong .gitignore). Nó chứa mật khẩu cơ sở
# dữ liệu, khoá ký token và mật khẩu ứng dụng Gmail.
# ============================================================

# ---------- Cơ sở dữ liệu ----------
# Sinh chuỗi ngẫu nhiên:  openssl rand -base64 24
DB_PASSWORD=

# ---------- Redis ----------
# Bắt buộc. Redis không mật khẩu trên máy chủ công cộng bị quét và chiếm rất nhanh.
# Sinh chuỗi ngẫu nhiên:  openssl rand -base64 24
REDIS_PASSWORD=

# ---------- Địa chỉ frontend ----------
# Domain FE trên Vercel, KHÔNG có dấu / ở cuối.
# Dùng để dựng link trong mail xác minh và mail đặt lại mật khẩu.
FRONTEND_URL=https://ten-du-an.vercel.app

# Danh sách domain được phép gọi API từ trình duyệt, ngăn cách bằng dấu phẩy.
# Sai giá trị này thì trang lên bình thường nhưng mọi lời gọi API bị chặn CORS.
# Vercel tạo thêm domain xem trước cho mỗi lần đẩy nhánh; muốn chúng gọi được
# API thì thêm mẫu:  https://ten-du-an.vercel.app,https://*-ten-tai-khoan.vercel.app
CORS_ALLOWED_ORIGINS=https://ten-du-an.vercel.app

# ---------- Khoá bí mật ----------
# Ký JWT. Đổi giá trị này là mọi người đang đăng nhập bị đăng xuất.
# Sinh chuỗi:  openssl rand -base64 64
JWT_SECRET=

# Mã hoá dữ liệu ngày/nơi sinh trong CSDL. PHẢI là base64 của đúng 32 byte.
# Sinh chuỗi:  openssl rand -base64 32
#
# ĐỔI KHOÁ NÀY SAU KHI ĐÃ CÓ DỮ LIỆU = KHÔNG GIẢI MÃ ĐƯỢC NỮA. Sinh một lần,
# rồi cất bản sao ở nơi khác ngoài VPS.
ASTRO_ENCRYPTION_KEY=

# ---------- Gửi mail ----------
# Với Gmail, MAIL_PASSWORD là "mật khẩu ứng dụng" 16 ký tự lấy ở
# myaccount.google.com/apppasswords, KHÔNG phải mật khẩu đăng nhập Gmail.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=Astra Tarot

# ---------- Google OAuth (để trống nếu chưa dùng) ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------- Gemini (trải bài bằng AI) ----------
GEMINI_API_KEY=
GEMINI_API_ENDPOINT=

# ---------- Tài khoản nhận chuyển khoản ----------
# Bỏ trống thì màn thanh toán hiện "Chưa cấu hình" và khách không biết chuyển
# tiền vào đâu.
BANK_NAME=
BANK_ACCOUNT_NUMBER=
BANK_ACCOUNT_HOLDER=

# ---------- Ghi log ----------
# Để WARN. Đổi sang DEBUG thì log phình rất nhanh và in ra cả đường dẫn lẫn
# quyền của từng người dùng.
SECURITY_LOG_LEVEL=WARN
